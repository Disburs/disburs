# Same-origin API (recommended): /api/* on this app is proxied to the backend,
# so the session cookie is first-party and works in every browser. Leave
# NEXT_PUBLIC_API_URL unset in this mode.
API_PROXY_TARGET=http://localhost:4000

# Direct mode instead: the browser calls the backend itself. Needs the backend's
# FRONTEND_URL to match this app, and cross-site cookies when on different sites.
# NEXT_PUBLIC_API_URL=http://localhost:4000
